pipeline{
    agent any

    environment{
        IMAGE_NAME = "danush242211ay/devops:${GIT_COMMIT}"
    }
    stages{
        stage('Git-Checkout'){
            steps{
                git url : 'https://github.com/danush242211ay/devops.git' ,branch : 'main'
            }
        }
        stage('Build'){
            steps{
                sh '''
                printenv
                pwd
                cd code/
                docker build -t ${IMAGE_NAME} .
                '''
            }
        }
        stage('Test the image'){
            steps{
                sh '''
                    docker run -it -d --name c1 -p 9001:8501 ${IMAGE_NAME}
                '''
            }
        }
    }
}